{
  "uid": "pawbridge-service",
  "title": "PawBridge 서비스 상세",
  "schemaVersion": 39,
  "version": 6,
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": false,
  "tags": [
    "pawbridge"
  ],
  "links": [
    { "type": "link", "title": "운영 현황", "url": "/d/pawbridge-overview", "includeVars": false, "keepTime": true, "targetBlank": false },
    { "type": "link", "title": "서비스 상세", "url": "/d/pawbridge-service", "includeVars": false, "keepTime": true, "targetBlank": false },
    { "type": "link", "title": "VM·파드 상세", "url": "/d/pawbridge-pods", "includeVars": false, "keepTime": true, "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "네임스페이스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": { "query": "label_values(kube_pod_info, namespace)", "refId": "namespace" },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": { "text": "pawbridge", "value": "pawbridge" },
        "hide": 0
      },
      {
        "name": "service",
        "label": "마이크로서비스 · app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": {
          "query": "label_values(kube_pod_labels{namespace=\"$namespace\",label_app!=\"\"}, label_app)",
          "refId": "service"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": { "text": "animal-service", "value": "animal-service" },
        "hide": 0
      },
      {
        "name": "pod",
        "label": "파드 · 각각 별도 표시",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": {
          "query": "label_values(kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"}, pod)",
          "refId": "pod"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [],
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 36, "type": "logs", "title": "$service · 로그 (아래가 최신)",
      "description": "선택한 서비스의 모든 파드에서 최근 최대 1000줄을 조회해 과거→최신 순서로 표시합니다. 파드 이름표로 출처를 구분하며 아래 파드 선택과 독립적입니다. 보관 기간 밖·보안 필터 제외 로그는 표시되지 않습니다. 30초 주기 갱신이며 무제한 실시간 스트림이 아닙니다.",
      "datasource": {"type": "loki", "uid": "pawbridge-loki"},
      "gridPos": {"x": 0, "y": 35, "w": 24, "h": 12},
      "targets": [{"refId": "A", "expr": "{namespace=\"$namespace\",app=\"$service\"}", "queryType": "range", "direction": "backward", "maxLines": 1000, "legendFormat": "{{pod}}"}],
      "options": {"sortOrder": "Ascending", "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none"}
    },
    {
      "id": 28, "type": "timeseries", "title": "$service · JVM 힙 메모리",
      "description": "파드별 JVM 힙 사용량과 확보량입니다. 컨테이너 전체 메모리와 다릅니다. Python 서비스는 JVM 지표 대상이 아닙니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 0, "y": 19, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "noValue": "JVM 지표 없음"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum by(pod)(jvm_memory_used_bytes{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",area=\"heap\"})", "legendFormat": "{{pod}} · 힙 사용"},
        {"refId": "B", "expr": "sum by(pod)(jvm_memory_committed_bytes{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",area=\"heap\"})", "legendFormat": "{{pod}} · 힙 확보"}
      ], "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 29, "type": "timeseries", "title": "$service · JVM 스레드",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 8, "y": 19, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "noValue": "JVM 지표 없음"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "max by(pod)(jvm_threads_live_threads{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"})", "legendFormat": "{{pod}} · 현재 스레드"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 30, "type": "timeseries", "title": "$service · GC 정지 시간",
      "description": "초당 누적 GC pause 시간입니다. 평균 또는 최대 1회 정지 시간이 아닙니다. GC가 아직 발생하지 않았으면 지표가 없을 수 있습니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 16, "y": 19, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "suffix:s/s", "min": 0, "noValue": "GC 지표 없음"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by(pod)(rate(jvm_gc_pause_seconds_sum{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"}[$__rate_interval]))", "legendFormat": "{{pod}} · GC 정지"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 31, "type": "timeseries", "title": "$service · HTTP 요청량",
      "description": "actuator 경로를 제외한 서비스 전체 초당 요청량입니다. 서비스별 측정이므로 Gateway와 하위 서비스 값을 더하지 않습니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 0, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "noValue": "요청 또는 수집값 없음"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "요청/s"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 32, "type": "timeseries", "title": "$service · HTTP 평균 응답시간",
      "description": "완료된 요청의 시간 합계를 건수로 나눈 가중 평균입니다. p95가 아닙니다. 요청이 없으면 0ms가 아닌 빈 값입니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 8, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "noValue": "요청 또는 수집값 없음"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])) / (sum(rate(http_server_requests_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])) > 0)", "legendFormat": "평균 응답시간"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 33, "type": "timeseries", "title": "$service · HTTP 5xx 비율",
      "description": "완료된 HTTP 응답 중 5xx 비율입니다. 요청 자체가 없거나 지표가 없으면 빈 값으로 표시합니다. 4xx는 서버 오류율에 포함하지 않습니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"}, "gridPos": {"x": 16, "y": 27, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "noValue": "요청 또는 수집값 없음"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])) > 0)", "legendFormat": "5xx 비율"}],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "text",
      "title": "보는 방법",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": { "mode": "markdown", "content": "위쪽은 **선택한 서비스의 모든 파드 합계와 로그**, 아래쪽은 **파드마다 별도 그래프**입니다. 파드 선택은 아래 상세에만 적용됩니다. CPU 1 = 한 코어, 메모리 = working set, 네트워크 = 내부 통신을 포함한 송수신량입니다. JVM·HTTP 지표는 수집 대상 Spring 서비스에 표시하며 Python에는 적용되지 않습니다. 로그는 위가 과거, 아래가 최신입니다. HTTP는 서버 내부 평균이며 p95/p99와 외부 경로 지연은 별도 측정합니다. 먼저 Spring 지표 수집 상태를 확인합니다. 파드 네트워크는 집 회선 WAN 사용량이 아닙니다." }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "$service · 전체 메모리",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 0, "y": 3, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((sum by(namespace,pod) (container_memory_working_set_bytes{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",container!=\"\",container!=\"POD\"})) and on(namespace,pod) (max by(namespace,pod) (kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"})))",
          "legendFormat": "서비스 합계",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "$service · 전체 CPU",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 12, "y": 3, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "cores", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[$__rate_interval]))) and on(namespace,pod) (max by(namespace,pod) (kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"})))",
          "legendFormat": "서비스 합계",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "$service · 네트워크 속도",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 0, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((sum by(namespace,pod) (rate(container_network_receive_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",interface!=\"lo\"}[$__rate_interval]))) and on(namespace,pod) (max by(namespace,pod) (kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"})))",
          "legendFormat": "수신",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum((sum by(namespace,pod) (rate(container_network_transmit_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",interface!=\"lo\"}[$__rate_interval]))) and on(namespace,pod) (max by(namespace,pod) (kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"})))",
          "legendFormat": "송신",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "$service · 선택 기간 누적 트래픽",
      "description": "선택한 시간 범위의 증가량 추정치입니다. 내부 통신을 포함하며 과금용 계량이 아닙니다. 수집 공백은 복원하지 못합니다.",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 12, "y": 11, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((sum by(namespace,pod) (increase(container_network_receive_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",interface!=\"lo\"}[$__range]))) and on(namespace,pod) (max by(namespace,pod) (max_over_time(kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"}[$__range]))))",
          "legendFormat": "수신",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum((sum by(namespace,pod) (increase(container_network_transmit_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=\"$namespace\",interface!=\"lo\"}[$__range]))) and on(namespace,pod) (max by(namespace,pod) (max_over_time(kube_pod_labels{namespace=\"$namespace\",label_app=\"$service\"}[$__range]))))",
          "legendFormat": "송신",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 38,
      "type": "timeseries",
      "title": "$service · DB 연결 풀 사용량",
      "description": "파드·풀별 사용, 유휴, 설정된 최대 연결 수입니다. PostgreSQL 전체 연결 수와 다릅니다. Hikari 미사용 서비스에는 지표가 없습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pawbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "수집값 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(pod,pool)(hikaricp_connections_active{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"})",
          "legendFormat": "{{pod}} · {{pool}} · 사용",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by(pod,pool)(hikaricp_connections_idle{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"})",
          "legendFormat": "{{pod}} · {{pool}} · 유휴",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "max by(pod,pool)(hikaricp_connections_max{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"})",
          "legendFormat": "{{pod}} · {{pool}} · 최대",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 39,
      "type": "timeseries",
      "title": "$service · DB 연결 대기 수",
      "description": "연결을 기다리는 요청 수의 수집 시점 값입니다. 30초 수집 사이에 발생한 짧은 대기의 최고값을 보장하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pawbridge-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 47,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "수집값 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(pod,pool)(hikaricp_connections_pending{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"})",
          "legendFormat": "{{pod}} · {{pool}} · 대기",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "$service · DB 연결 획득 평균 시간",
      "description": "표시 구간의 누적 획득 시간 증가량을 획득 건수 증가량으로 나눈 평균입니다. p95/p99가 아니며 획득 건수가 없으면 빈 값입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pawbridge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "수집값 없음"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum by(pod,pool)(rate(hikaricp_connections_acquire_seconds_sum{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])) / (sum by(pod,pool)(rate(hikaricp_connections_acquire_seconds_count{job=\"pawbridge-spring-runtime\",namespace=\"$namespace\",service=\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{pod}} · {{pool}} · 평균",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "$service · DB 연결 획득 타임아웃",
      "description": "파드·풀별 새 연결 획득 타임아웃의 초당 발생률입니다. 누적 건수와 다릅니다. 수집되지 않은 지표를 0으로 채우지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "pawbridge-prometheus"
      },
      "gridPos": {
        "x": 18,
