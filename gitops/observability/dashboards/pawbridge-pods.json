{
  "uid": "pawbridge-pods",
  "title": "PawBridge VM·파드 상세",
  "schemaVersion": 39,
  "version": 4,
  "timezone": "Asia/Seoul",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": false,
  "tags": [
    "pawbridge"
  ],
  "links": [
    { "type": "link", "title": "운영 현황", "url": "/d/pawbridge-overview", "includeVars": false, "keepTime": true, "targetBlank": false },
    { "type": "link", "title": "서비스 상세", "url": "/d/pawbridge-service", "includeVars": false, "keepTime": true, "targetBlank": false },
    { "type": "link", "title": "VM·파드 상세", "url": "/d/pawbridge-pods", "includeVars": false, "keepTime": true, "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "VM",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": { "query": "label_values(kube_node_info, node)", "refId": "node" },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": { "text": "pawbridge-k136-w2", "value": "pawbridge-k136-w2" },
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "네임스페이스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": { "query": "label_values(kube_pod_info, namespace)", "refId": "namespace" },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "options": [],
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      },
      {
        "name": "pod",
        "label": "파드",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
        "query": {
          "query": "label_values(kube_pod_info{node=\"$node\",namespace=~\"$namespace\"}, pod)",
          "refId": "pod"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 35, "type": "timeseries", "title": "$node · 메모리 용량 추이",
      "description": "선택한 VM의 총량·사용량·가용량입니다. 사용량=MemTotal−MemAvailable이며 파드 working set 합계와 다릅니다. 수집 공백을 0으로 채우거나 선으로 연결하지 않습니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "noValue": "수집값 없음", "custom": {"spanNulls": false, "stacking": {"mode": "none", "group": "A"}}}, "overrides": [
        {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "gray"}}]},
        {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
        {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}
      ]},
      "targets": [
        {"refId": "A", "expr": "max(node_memory_MemTotal_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "총량", "instant": false, "range": true},
        {"refId": "B", "expr": "max(node_memory_MemTotal_bytes{job=\"node-exporter\",node=\"$node\"}) - max(node_memory_MemAvailable_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "사용량 (총량−가용량)", "instant": false, "range": true},
        {"refId": "C", "expr": "max(node_memory_MemAvailable_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "가용량", "instant": false, "range": true}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 37, "type": "logs", "title": "$pod · 로그 (아래가 최신)",
      "description": "선택 기간의 최근 최대 1000줄을 과거→최신 순서로 표시합니다. pawbridge 앱과 Animal 배치만 수집하며 DB·모니터링 파드는 대상이 아닙니다. 로그 없음은 오류 없음의 보장이 아닙니다. 보안 필터로 제외된 줄과 보관 기간 밖 로그는 표시되지 않습니다.",
      "datasource": {"type": "loki", "uid": "pawbridge-loki"},
      "gridPos": {"x": 0, "y": 47, "w": 24, "h": 12},
      "targets": [{"refId": "A", "expr": "{namespace=~\"$namespace\",pod=\"$pod\"}", "queryType": "range", "direction": "backward", "maxLines": 1000, "legendFormat": "{{pod}}"}],
      "options": {"sortOrder": "Ascending", "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none"}
    },
    {
      "id": 26, "type": "stat", "title": "$node · 전체 메모리 / 가용 메모리 / 가용 비율",
      "description": "VM 운영체제가 인식하는 MemTotal과 MemAvailable입니다. 가용 비율은 Slack 메모리 경보와 같은 기준이며 캐시를 포함한 단순 free 값이 아닙니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"},
      "gridPos": {"x": 0, "y": 3, "w": 24, "h": 5},
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "수집값 없음", "min": 0}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "max", "value": 100}]}]},
      "targets": [
        {"refId": "A", "expr": "max(node_memory_MemTotal_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "전체 메모리", "instant": true},
        {"refId": "B", "expr": "max(node_memory_MemAvailable_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "가용 메모리", "instant": true},
        {"refId": "C", "expr": "100 * max(node_memory_MemAvailable_bytes{job=\"node-exporter\",node=\"$node\"}) / max(node_memory_MemTotal_bytes{job=\"node-exporter\",node=\"$node\"})", "legendFormat": "가용 비율", "instant": true}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "orientation": "horizontal", "graphMode": "none", "colorMode": "none"}
    },
    {
      "id": 27, "type": "stat", "title": "$pod · 현재 메모리 용량",
      "description": "일반 컨테이너 기준입니다. 사용량은 working set, 요청량은 스케줄링 예약 기준입니다. 하나라도 메모리 제한이 없는 컨테이너가 있으면 제한 합계를 표시하지 않습니다. Pod-level resources와 init container는 포함하지 않습니다. 지표가 없으면 수집값 없음입니다.",
      "datasource": {"type": "prometheus", "uid": "pawbridge-prometheus"},
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 5},
      "fieldConfig": {"defaults": {"unit": "bytes", "noValue": "수집값 없음", "mappings": [{"type": "value", "options": {"-1": {"text": "제한 없음(전체 또는 일부)"}}}]}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(container_memory_working_set_bytes{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",pod=\"$pod\",container!=\"\",container!=\"POD\"})", "legendFormat": "현재 사용량", "instant": true},
        {"refId": "B", "expr": "sum(kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"})", "legendFormat": "컨테이너 요청 합계", "instant": true},
        {"refId": "C", "expr": "(sum(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"}) and (count(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"} > 0) == count(kube_pod_container_info{namespace=~\"$namespace\",pod=\"$pod\"}))) or ((0 * count(kube_pod_container_info{namespace=~\"$namespace\",pod=\"$pod\"}) - 1) unless (count(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"} > 0) == count(kube_pod_container_info{namespace=~\"$namespace\",pod=\"$pod\"})))", "legendFormat": "컨테이너 제한 합계", "instant": true}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "orientation": "horizontal", "graphMode": "none", "colorMode": "none"}
    },
    {
      "id": 18,
      "type": "text",
      "title": "보는 방법",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": { "mode": "markdown", "content": "**VM → 네임스페이스 → 파드** 순서로 선택합니다. 위쪽 막대는 해당 VM의 파드를 비교하고, 아래쪽은 선택한 파드 하나만 보여줍니다. 서비스 이름표가 없는 배치·DB·모니터링 파드도 조회할 수 있습니다." }
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "$node · 파드별 메모리 비교",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "수집값 없음",
          "links": [
            {
              "title": "이 파드 상세 보기",
              "url": "/d/pawbridge-pods?var-node=${node:percentencode}&var-namespace=${__field.labels.namespace}&var-pod=${__field.labels.pod}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc((sum by(namespace,pod) (container_memory_working_set_bytes{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",container!=\"\",container!=\"POD\"})) and on(namespace,pod) (max by(namespace,pod)(kube_pod_info{node=\"$node\",namespace=~\"$namespace\"})))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "$node · 파드별 CPU 비교",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "noValue": "수집값 없음",
          "links": [
            {
              "title": "이 파드 상세 보기",
              "url": "/d/pawbridge-pods?var-node=${node:percentencode}&var-namespace=${__field.labels.namespace}&var-pod=${__field.labels.pod}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc((sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",container!=\"\",container!=\"POD\"}[$__rate_interval]))) and on(namespace,pod) (max by(namespace,pod)(kube_pod_info{node=\"$node\",namespace=~\"$namespace\"})))",
          "legendFormat": "{{namespace}} / {{pod}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "$pod · 메모리",
      "description": "일반 컨테이너의 합계입니다. 요청은 예약 기준이지 실제 사용량이 아닙니다. 제한 미설정 컨테이너는 제한 합계에 포함되지 않으므로 전체 파드의 강제 상한으로 해석하지 마세요. Pod-level resources와 init container는 이 비교선에 포함하지 않습니다.",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod) (container_memory_working_set_bytes{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",pod=\"$pod\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "실사용",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(namespace,pod)(kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"})",
          "legendFormat": "컨테이너 요청 합계",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum by(namespace,pod)(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=\"$pod\",resource=\"memory\"})",
          "legendFormat": "컨테이너 제한 합계",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "$pod · CPU",
      "description": "일반 컨테이너의 합계입니다. 요청은 예약 기준이지 실제 사용량이 아닙니다. 제한 미설정 컨테이너는 제한 합계에 포함되지 않으므로 전체 파드의 강제 상한으로 해석하지 마세요. Pod-level resources와 init container는 이 비교선에 포함하지 않습니다.",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "cores", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",pod=\"$pod\",container!=\"\",container!=\"POD\"}[$__rate_interval]))",
          "legendFormat": "실사용",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(namespace,pod)(kube_pod_container_resource_requests{namespace=~\"$namespace\",pod=\"$pod\",resource=\"cpu\"})",
          "legendFormat": "컨테이너 요청 합계",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum by(namespace,pod)(kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=\"$pod\",resource=\"cpu\"})",
          "legendFormat": "컨테이너 제한 합계",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "$pod · 네트워크 속도",
      "description": "",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 0, "y": 39, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod) (rate(container_network_receive_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",pod=\"$pod\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "수신",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by(namespace,pod) (rate(container_network_transmit_bytes_total{job=\"kubelet\",metrics_path=\"/metrics/cadvisor\",namespace=~\"$namespace\",pod=\"$pod\",interface!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "송신",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "$pod · 재시작 횟수 (선택 기간)",
      "description": "선택 기간의 카운터 증가 추정값입니다. 파드 교체 횟수가 아닙니다.",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 12, "y": 39, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "noValue": "수집값 없음" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod)(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=\"$pod\"}[$__range]))",
          "legendFormat": "재시작",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "$pod · 배치 VM / 파드 준비 상태",
      "description": "VM 이름은 파드가 배치된 위치입니다. 상태는 VM 자체가 아니라 파드의 Ready 조건입니다. 준비됨(1), 준비 안 됨(0)으로 표시하며 수집값 없음은 정상으로 간주하지 않습니다.",
      "datasource": { "type": "prometheus", "uid": "pawbridge-prometheus" },
      "gridPos": { "x": 18, "y": 39, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "noValue": "수집값 없음", "mappings": [{ "type": "value", "options": { "0": { "text": "파드 준비 안 됨", "color": "red" }, "1": { "text": "파드 준비됨", "color": "green" } } }] },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,pod,node)(kube_pod_info{namespace=~\"$namespace\",pod=\"$pod\"}) * on(namespace,pod) group_left() max by(namespace,pod)(kube_pod_status_ready{namespace=~\"$namespace\",pod=\"$pod\",condition=\"true\"})",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    }
  ]
}
