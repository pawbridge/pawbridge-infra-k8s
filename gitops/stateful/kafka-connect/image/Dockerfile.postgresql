# Add the PostgreSQL connector to the existing immutable MySQL/ES worker.
# Dedicated PostgreSQL CI builds this file; the live KafkaConnect manifest is unchanged.
ARG CONNECT_BASE_IMAGE=docker.io/dorosiya/pawbridge-debezium-connect@sha256:cd51857d670c359d658e76ca86a097322daedff762311953193a7994b259f337
FROM ${CONNECT_BASE_IMAGE} AS postgres-plugin
ARG DEBEZIUM_POSTGRES_VERSION=3.5.2.Final
ARG DEBEZIUM_POSTGRES_SHA512=7ee20a5106d11068677dd81d06fad7ee1c2fa09ba31658ecfed5dc9611e8fd73417251b9a5661e5425d8cfac1f868afb83dec56027639f54394e8f4d1f7f4c4e
USER 1001
RUN mkdir -p /tmp/postgresql-plugin \
    && curl --fail --show-error --silent --location --proto '=https' --tlsv1.2 \
       --retry 3 --connect-timeout 15 --max-time 300 \
       "https://repo.maven.apache.org/maven2/io/debezium/debezium-connector-postgres/${DEBEZIUM_POSTGRES_VERSION}/debezium-connector-postgres-${DEBEZIUM_POSTGRES_VERSION}-plugin.tar.gz" \
       --output /tmp/postgresql-plugin.tar.gz \
    && echo "${DEBEZIUM_POSTGRES_SHA512}  /tmp/postgresql-plugin.tar.gz" | sha512sum -c - \
    && tar --extract --gzip --file /tmp/postgresql-plugin.tar.gz \
       --directory /tmp/postgresql-plugin --strip-components=1 \
    && test -r /tmp/postgresql-plugin/debezium-connector-postgres-${DEBEZIUM_POSTGRES_VERSION}.jar
FROM ${CONNECT_BASE_IMAGE}
USER root
COPY --from=postgres-plugin --chown=1001:0 /tmp/postgresql-plugin/ /opt/kafka/plugins/debezium-postgresql/
USER 1001
RUN test -r /opt/kafka/plugins/debezium-postgresql/debezium-connector-postgres-3.5.2.Final.jar \
    && test -r /opt/kafka/plugins/debezium-mysql/debezium-connector-mysql-3.5.2.Final.jar \
    && test -r /opt/kafka/plugins/elasticsearch/kafka-connect-elasticsearch-15.1.3.jar
