{
  "name": "${OPERATING_PROJECT}",
  "services": {
    "postgres": {
      "image": "sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f",
      "platform": "linux/arm64",
      "pull_policy": "never",
      "container_name": "${OPERATING_PROJECT}-postgres",
      "restart": "unless-stopped",
      "read_only": true,
      "user": "${OPERATING_UID}:${OPERATING_GID}",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": 1073741824,
      "memswap_limit": 1073741824,
      "cpus": 1.0,
      "pids_limit": 256,
      "stop_grace_period": "60s",
      "labels": {
        "com.pawbridge.operating-owner": "${OPERATING_OWNER}"
      },
      "env_file": [
        {
          "path": "${OPERATING_SECRETS}/postgres.env",
          "format": "raw"
        }
      ],
      "networks": {
        "private": {},
        "backup-private": {
          "ipv4_address": "10.203.254.2"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,size=64m",
        "/var/run/postgresql:rw,nosuid,size=8m,mode=0777"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-data",
          "target": "/var/lib/postgresql/data",
          "read_only": false,
          "volume": {
            "nocopy": true
          }
        },
        {
          "type": "bind",
          "source": "${BACKGROUND_CONFIG}/pg_hba.conf",
          "target": "/etc/postgresql/pg_hba.conf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "entrypoint": [
        "postgres"
      ],
      "command": [
        "-c",
        "listen_addresses=*",
        "-c",
        "wal_level=logical",
        "-c",
        "max_replication_slots=5",
        "-c",
        "max_wal_senders=8",
        "-c",
        "max_slot_wal_keep_size=512MB",
        "-c",
        "shared_buffers=128MB",
        "-c",
        "max_connections=80",
        "-c",
        "work_mem=4MB",
        "-c",
        "temp_file_limit=256MB",
        "-c",
        "autovacuum=on",
        "-c",
        "log_statement=none",
        "-c",
        "log_min_error_statement=panic",
        "-c",
        "hba_file=/etc/postgresql/pg_hba.conf"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "postgres",
          "-d",
          "pawbridge"
        ],
        "interval": "10s",
        "timeout": "3s",
        "retries": 6
      }
    },
