# -*- mode: ruby -*-
# vi: set ft=ruby :

# PawBridge K8s Cluster - Vagrant Configuration
# VM: 1 Control Plane + 2 Workers (fully automated)

# 필요한 플러그인 자동 설치
required_plugins = %w(vagrant-disksize)
required_plugins.each do |plugin|
  unless Vagrant.has_plugin?(plugin)
    system("vagrant plugin install #{plugin}") || exit!
    exit system('vagrant', *ARGV)
  end
end

# 노드 설정 (64GB RAM 환경 최적화)
# Master: CPU 4개 필수 (컨트롤 플레인 + Calico 등 많은 컴포넌트 실행)
NODES = [
  { name: "k8s-master", ip: "192.168.56.70", cpus: 4, memory: 6144, role: "master" },
  { name: "k8s-worker1", ip: "192.168.56.71", cpus: 4, memory: 8192, role: "worker" },
  { name: "k8s-worker2", ip: "192.168.56.72", cpus: 4, memory: 8192, role: "worker" }
]

Vagrant.configure("2") do |config|
  # Ubuntu 22.04 LTS 사용 (VirtualBox 호환성 최고)
  config.vm.box = "ubuntu/jammy64"
  
  # Disk 확장 설정
  config.disksize.size = "50GB"
  
  # 공유 폴더 비활성화 (보안)
  config.vm.synced_folder "./", "/vagrant", disabled: true

  # 공통 프로비저닝
  config.vm.provision :shell, privileged: true, inline: $install_common

  NODES.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.hostname = node[:name]
      n.vm.network "private_network", ip: node[:ip]
      
      # VirtualBox 설정
      n.vm.provider :virtualbox do |vb|
        vb.name = node[:name]
        vb.cpus = node[:cpus]
        vb.memory = node[:memory]
        vb.gui = false
        vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
        # 시간 동기화 강화
        vb.customize ["guestproperty", "set", :id, "/VirtualBox/GuestAdd/VBoxService/--timesync-set-threshold", "1000"]
        # 네트워크 성능 향상
        vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
        vb.customize ["modifyvm", :id, "--nictype2", "virtio"]
      end
      
      # Master 노드 추가 프로비저닝
      if node[:role] == "master"
        n.vm.provision :shell, privileged: true, inline: $install_master
      end
      
      # Worker 노드 추가 프로비저닝
      if node[:role] == "worker"
        n.vm.provision :shell, privileged: true, inline: $install_worker, args: [node[:name]]
      end
    end
  end
end

# ========================================
# 공통 설치 스크립트 (Master + Worker)
# ========================================
$install_common = <<-SHELL

echo '======== [1] Ubuntu 기본 설정 ========'
timedatectl set-timezone Asia/Seoul

echo '======== [1-1] 패키지 업데이트 ========'
apt-get update
apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release conntrack socat iproute2 chrony

echo '======== [1-1-1] NTP 시간 동기화 설정 ========'
systemctl enable --now chrony
chronyc makestep

echo '======== [1-2] Swap 비활성화 ========'
swapoff -a && sed -i '/ swap / s/^/#/' /etc/fstab

echo '======== [1-2-1] 커널 파라미터 설정 (Elasticsearch 등) ========'
# vm.max_map_count 설정 (Elasticsearch 필수)
sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" | tee -a /etc/sysctl.conf

echo '======== [1-3] hosts 설정 ========'
cat <<EOF >> /etc/hosts
192.168.56.70 k8s-master
192.168.56.71 k8s-worker1
192.168.56.72 k8s-worker2
EOF

echo '======== [2] 컨테이너 런타임 (containerd) 설치 ========'
echo '======== [2-1] 커널 모듈 설정 ========'
cat <<EOF | tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOF
modprobe overlay
modprobe br_netfilter

cat <<EOF | tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOF
sysctl --system

echo '======== [2-2] containerd 설치 (v1.7.29 고정) ========'
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor --yes -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list
apt-get update
# K8s 1.27 호환성 1.7.29 버전 고정 (SystemdCgroup 필수)
apt-get install -y --allow-downgrades containerd.io=1.7.29-1~ubuntu.22.04~jammy
apt-mark hold containerd.io
systemctl enable --now containerd

echo '======== [2-3] containerd cgroup 설정 ========'
containerd config default | tee /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
systemctl restart containerd

echo '======== [3] Kubernetes 설치 (v1.27 - 바이너리 직접 설치) ========'
K8S_VERSION="v1.27.16"
CRICTL_VERSION="v1.27.0"

# kubectl 다운로드
curl -LO "https://dl.k8s.io/release/${K8S_VERSION}/bin/linux/amd64/kubectl"
install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
rm -f kubectl

# kubeadm 다운로드
curl -LO "https://dl.k8s.io/release/${K8S_VERSION}/bin/linux/amd64/kubeadm"
install -o root -g root -m 0755 kubeadm /usr/local/bin/kubeadm
rm -f kubeadm

# kubelet 다운로드  
curl -LO "https://dl.k8s.io/release/${K8S_VERSION}/bin/linux/amd64/kubelet"
install -o root -g root -m 0755 kubelet /usr/local/bin/kubelet
rm -f kubelet

# crictl 다운로드 (kubeadm에서 필요)
curl -LO "https://github.com/kubernetes-sigs/cri-tools/releases/download/${CRICTL_VERSION}/crictl-${CRICTL_VERSION}-linux-amd64.tar.gz"
tar -zxvf crictl-${CRICTL_VERSION}-linux-amd64.tar.gz -C /usr/local/bin
rm -f crictl-${CRICTL_VERSION}-linux-amd64.tar.gz

# crictl 설정 (containerd 사용) - timeout 30초로 증가
cat <<EOF | tee /etc/crictl.yaml
runtime-endpoint: unix:///run/containerd/containerd.sock
image-endpoint: unix:///run/containerd/containerd.sock
timeout: 30
EOF

# Worker 노드용 manifests 디렉토리 생성 (에러 로그 방지)
mkdir -p /etc/kubernetes/manifests

# kubelet 서비스 설정
mkdir -p /etc/systemd/system/kubelet.service.d
cat <<EOF | tee /etc/systemd/system/kubelet.service
[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/kubelet
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

# kubelet 설정 드롭인
cat <<'EOF' | tee /etc/systemd/system/kubelet.service.d/10-kubeadm.conf
[Service]
Environment="KUBELET_KUBECONFIG_ARGS=--bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf --kubeconfig=/etc/kubernetes/kubelet.conf"
Environment="KUBELET_CONFIG_ARGS=--config=/var/lib/kubelet/config.yaml"
EnvironmentFile=-/var/lib/kubelet/kubeadm-flags.env
EnvironmentFile=-/etc/default/kubelet
ExecStart=
ExecStart=/usr/local/bin/kubelet $KUBELET_KUBECONFIG_ARGS $KUBELET_CONFIG_ARGS $KUBELET_KUBEADM_ARGS $KUBELET_EXTRA_ARGS
EOF

systemctl daemon-reload
systemctl enable kubelet
# kubelet은 kubeadm init/join이 시작시킴 (여기서 --now 사용하면 포트 충돌!)

SHELL

# ========================================
# Master 노드 전용 스크립트
# ========================================
$install_master = <<-SHELL

echo '======== [4] kubeadm 클러스터 초기화 ========'
if ! kubeadm init --pod-network-cidr=10.244.0.0/16 --apiserver-advertise-address=192.168.56.70; then
  echo 'kubeadm init 실패! 스크립트 중단.'
  exit 1
fi

echo '======== [4-1] kubectl 설정 ========'
mkdir -p $HOME/.kube
cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
chown $(id -u):$(id -g) $HOME/.kube/config
export KUBECONFIG=$HOME/.kube/config

# vagrant 사용자도 kubectl 사용 가능하도록
mkdir -p /home/vagrant/.kube
cp -i /etc/kubernetes/admin.conf /home/vagrant/.kube/config
chown -R vagrant:vagrant /home/vagrant/.kube

echo '======== [4-2] Pod Network (Calico) 설치 ========'
kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.26.4/manifests/tigera-operator.yaml

# tigera-operator CRD 준비 대기
echo 'tigera-operator CRD 대기 중...'
sleep 15
cat <<EOF | kubectl apply -f -
apiVersion: operator.tigera.io/v1
kind: Installation
metadata:
  name: default
spec:
  calicoNetwork:
    ipPools:
    - blockSize: 26
      cidr: 10.244.0.0/16
      encapsulation: VXLANCrossSubnet
      natOutgoing: Enabled
      nodeSelector: all()
---
apiVersion: operator.tigera.io/v1
kind: APIServer
metadata:
  name: default
spec: {}
EOF

# Calico 설치 완료 대기 (최대 5분)
echo 'Calico 설치 대기 중... (최대 5분)'
for i in {1..60}; do
  READY=$(kubectl get pods -n calico-system --no-headers 2>/dev/null | grep -c 'Running' || true)
  READY=${READY:-0}
  READY=$(echo $READY | tr -d '\n')
  if [ "$READY" -ge 2 ] 2>/dev/null; then
    echo "Calico Pod $READY개 Running!"
    break
  fi
  echo "대기 중... ($i/60) - 현재 Running: $READY"
  sleep 5
done

# 노드 Ready 대기
echo '노드 Ready 상태 대기 중...'
for i in {1..30}; do
  STATUS=$(kubectl get nodes k8s-master --no-headers 2>/dev/null | awk '{print $2}' | tr -d '\n')
  STATUS=${STATUS:-NotReady}
  if [ "$STATUS" = "Ready" ]; then
    echo "Master 노드 Ready!"
    break
  fi
  echo "대기 중... ($i/30) - 현재: $STATUS"
  sleep 5
done

# Master Taint는 유지 (워크로드는 Worker 노드에서만 실행)
# kubectl taint nodes k8s-master node-role.kubernetes.io/control-plane- || true

echo '======== [5] 편의 기능 설치 ========'
echo '======== [5-1] kubectl 자동완성 ========'
echo "source <(kubectl completion bash)" >> /root/.bashrc
echo 'alias k=kubectl' >> /root/.bashrc
echo 'complete -o default -F __start_kubectl k' >> /root/.bashrc

echo "source <(kubectl completion bash)" >> /home/vagrant/.bashrc
echo 'alias k=kubectl' >> /home/vagrant/.bashrc
echo 'complete -o default -F __start_kubectl k' >> /home/vagrant/.bashrc

echo '======== [5-2] Helm 설치 ========'
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
# Helm 설치 확인
if [ -f /usr/local/bin/helm ]; then
  echo 'Helm 설치 성공!'
  /usr/local/bin/helm version
else
  echo 'Helm 설치 실패!'
  exit 1
fi

# Helm repo 추가
echo 'Helm 레포지토리 추가 중...'
/usr/local/bin/helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
/usr/local/bin/helm repo add ingress-nginx https://kubernetes.github.io/ingress-nginx || true
/usr/local/bin/helm repo add bitnami https://charts.bitnami.com/bitnami || true
/usr/local/bin/helm repo add strimzi https://strimzi.io/charts/ || true
/usr/local/bin/helm repo update

echo '======== [5-3] Local Path Provisioner 설치 (스토리지) ========'
kubectl apply -f https://raw.githubusercontent.com/rancher/local-path-provisioner/v0.0.34/deploy/local-path-storage.yaml
# default StorageClass로 설정
sleep 10
kubectl patch storageclass local-path -p '{"metadata": {"annotations":{"storageclass.kubernetes.io/is-default-class":"true"}}}'

echo '======== [5-4] Worker Join 토큰 저장 ========'
# Worker 노드가 자동으로 Join할 수 있도록 토큰 저장
kubeadm token create --print-join-command > /tmp/kubeadm_join_command.sh
chmod 644 /tmp/kubeadm_join_command.sh

echo ''
echo '========================================'
echo '  Master 노드 클러스터 초기화 완료!'
echo '========================================'
echo ''
echo '[Worker Join 명령어]'
cat /tmp/kubeadm_join_command.sh
echo ''
echo '[다음 단계]'
echo '1. Worker 노드 Join: vagrant ssh k8s-worker1 후 아래 명령 실행'
echo '   sudo $(cat /tmp/kubeadm_join_command.sh)'
echo ''
echo '2. 인프라 설치: install-infra.sh 실행'
echo ''

SHELL

# ========================================
# Worker 노드 전용 스크립트
# ========================================
$install_worker = <<-SHELL

echo ''
echo '========================================'
echo '  Worker 노드 설치 완료!'
echo '========================================'
echo ''
echo 'Master 노드에서 아래 명령어로 Join 토큰을 확인하세요:'
echo '  vagrant ssh k8s-master'
echo '  kubeadm token create --print-join-command'
echo ''
echo '그 다음 이 노드에서 sudo로 실행하세요.'
echo ''

SHELL
